<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Contact · Marginalia</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Literata:ital,wght@0,400;0,500;1,400&family=Karla:wght@400;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="css/style.css">
</head>
<body>

<header class="site-header">
  <nav class="nav container">
    <a href="index.html" class="logo"><span class="mark">M</span>arginalia <span class="tagline">Books, unhurried</span></a>
    <button class="nav-toggle" data-nav-toggle aria-label="Toggle menu" aria-expanded="false"><span></span></button>
    <ul class="nav-links" data-nav-links>
      <li><a href="index.html">Home</a></li>
      <li><a href="shop.html">Shop</a></li>
      <li><a href="about.html">About</a></li>
      <li><a href="contact.html" aria-current="page">Contact</a></li>
    </ul>
    <div class="nav-actions">
      <a href="cart.html" class="cart-link">Cart <span class="cart-badge" data-cart-badge>0</span></a>
    </div>
  </nav>
</header>

<div class="page-header">
  <div class="container">
    <span class="breadcrumb"><a href="index.html">Home</a> / Contact</span>
    <h1>Get in touch</h1>
  </div>
</div>

<main class="section">
  <div class="container contact-layout">
    <div>
      <h2 class="mt-0">Send us a message</h2>
      <form id="contact-form" novalidate>
        <div class="form-field">
          <label for="ct-name">Name</label>
          <input type="text" id="ct-name" name="name" autocomplete="name">
          <span class="field-error"></span>
        </div>
        <div class="form-field">
          <label for="ct-email">Email</label>
          <input type="email" id="ct-email" name="email" autocomplete="email">
          <span class="field-error"></span>
        </div>
        <div class="form-field">
          <label for="ct-message">Message</label>
          <textarea id="ct-message" name="message" rows="5"></textarea>
          <span class="field-error"></span>
        </div>
        <button type="submit" class="btn btn-primary">Send message</button>
        <div class="form-success" id="contact-success"></div>
      </form>
    </div>

    <div class="contact-info-card">
      <h2 class="mt-0">Visit or write</h2>
      <dl>
        <dt>Shop address</dt>
        <dd>14 Bindery Lane, Warrington, UK</dd>
        <dt>Opening hours</dt>
        <dd>Tuesday–Saturday, 10am–6pm</dd>
        <dt>Email</dt>
        <dd>hello@marginalia-books.example</dd>
        <dt>Phone</dt>
        <dd>+44 1925 000 000</dd>
      </dl>
    </div>
  </div>
</main>

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <div class="footer-logo">Marginalia</div>
      <p>A small bookshop for people who dog-ear pages and write in the margins.</p>
      <form class="newsletter-form" onsubmit="return false;">
        <label for="newsletter-email" class="visually-hidden">Email address</label>
        <input type="email" id="newsletter-email" placeholder="Your email">
        <button type="submit" class="btn btn-primary">Join</button>
      </form>
    </div>
    <div>
      <h4>Shop</h4>
      <ul>
        <li><a href="shop.html">All books</a></li>
        <li><a href="cart.html">Your cart</a></li>
        <li><a href="about.html">About us</a></li>
      </ul>
    </div>
    <div>
      <h4>Support</h4>
      <ul>
        <li><a href="contact.html">Contact us</a></li>
        <li><a href="contact.html">Shipping &amp; returns</a></li>
        <li><a href="contact.html">FAQs</a></li>
      </ul>
    </div>
    <div>
      <h4>Visit</h4>
      <p>14 Bindery Lane<br>Warrington, UK</p>
      <p>Tue–Sat, 10am–6pm</p>
    </div>
  </div>
  <div class="container footer-bottom">
    <span>© <span data-year></span> Marginalia Books. All rights reserved.</span>
    <span>Made with ink and a little dust.</span>
  </div>
</footer>

<script src="js/products.js"></script>
<script src="js/cart.js"></script>
<script src="js/contact.js"></script>
<script src="js/common.js"></script>
</body>
</html>
